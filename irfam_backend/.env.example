# EXEMPLE DE FICHIER .env POUR LA PRODUCTION
# Copiez ce fichier en .env et remplissez les valeurs

# Django
SECRET_KEY=votre-cle-secrete-unique-et-longue-ici
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com

# Base de données PostgreSQL (pour production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=irfam_db
DB_USER=irfam_user
DB_PASSWORD=votre-mot-de-passe-securise
DB_HOST=localhost
DB_PORT=5432

# Base de données SQLite (pour développement)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Sécurité
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com

# Email (optionnel - pour notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app

# Fichiers statiques (pour production)
STATIC_ROOT=/var/www/irfam/static/
MEDIA_ROOT=/var/www/irfam/media/

# Backup
BACKUP_DIR=/var/backups/irfam/
